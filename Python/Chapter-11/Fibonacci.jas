.class public Fibonacci
.super java/lang/Object

.method public <init>()V
    aload 0
    invokenonvirtual java/lang/Object/<init>()V
    return
.end method

.method public static main([Ljava/lang/String;)V
    .limit locals 1
    .limit stack  3
    getstatic     java/lang/System/out Ljava/io/PrintStream;
    ldc           34
    invokestatic  Fibonacci/fibonacci(I)I
    invokevirtual java/io/PrintStream/println(I)V
    return
.end method

.method public static fibonacci(I)I
    .limit locals 3
    .limit stack  2
    ldc    0
    istore 1            ; s = 0;
    ldc    1
    istore 2            ; t = 1;
loop:
    iload  0            ; load n
    ifeq   finish       ; if (n == 0) goto finish;
    iload  1            ; load s
    iload  2            ; load t
    iadd
    istore  1           ; s = s + t;
    iload   1           ; load s
    iload   2           ; load t
    isub
    istore  2           ; t = s - t;
    iload   0           ; load n
    ldc    1
    isub
    istore  0           ; n = n - 1;
    goto    loop
finish:
    iload   1
    ireturn             ; return s;
.end method
